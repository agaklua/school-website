NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon/publishable key only. Never put a service-role or sb_secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only; required for admission intake and status checks. Never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-secret
